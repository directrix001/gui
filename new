ZERO = "=0"   # placeholder formula written to cells when source data is absent


def _is_empty(df):
    """Returns True if df is None, not a DataFrame, or has no rows/columns."""
    if df is None:
        return True
    if not isinstance(df, pd.DataFrame):
        return True
    return df.empty


def safe_row(val, fallback=0):
    """Return val as int if valid, else fallback."""
    if val is None:
        return fallback
    try:
        return int(val)
    except (TypeError, ValueError):
        return fallback


def safe_col(val, fallback=0):
    """Same as safe_row – separate name for readability."""
    return safe_row(val, fallback)


def safe_formula(fn, *args, **kwargs):
    """
    Call fn(*args, **kwargs).
    If anything raises or returns None, return ZERO.
    """
    try:
        result = fn(*args, **kwargs)
        return result if result is not None else ZERO
    except Exception:
        return ZERO


def safe_extract(path, sheet, row, col):
    """
    Wrapper around extract_formula that returns ZERO when the file is
    missing or the call raises any exception.
    """
    import os
    if not path or not os.path.isfile(str(path)):
        return ZERO
    try:
        result = extract_formula(path, sheet, row, col)
        return result if result else ZERO
    except Exception:
        return ZERO


