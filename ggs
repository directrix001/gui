"""
Formula Regeneration Utility for Variance Report (xlwings)
==========================================================

Usage:
    regenerate_formula(wb, category, quarter, month, row)

    wb        : xlwings Book object (already open)
    category  : one of the CATEGORY keys below (e.g. "Actual", "OL (1+2)")
    quarter   : integer 1-4
    month     : integer 1-3 (position within quarter: 1=first month, 2=second, 3=third)
                OR pass None to regenerate ALL three months + the Q-sum for that quarter
    row       : Excel row number (int) to write the formula into

Examples:
    import xlwings as xw
    wb = xw.Book("var_test.xlsx")
    ws = wb.sheets["Sheet1"]

    # Rebuild Actual M10 (Q4, month 1) on row 7
    regenerate_formula(ws, "Actual", quarter=4, month=1, row=7)

    # Rebuild all months + Q-sum for OL (1+2) Q4 on row 7
    regenerate_formula(ws, "OL (1+2)", quarter=4, month=None, row=7)

    # Rebuild Act vs OL Q3, month 2 (= M08) on row 15
    regenerate_formula(ws, "Act vs OL", quarter=3, month=2, row=15)
"""

import xlwings as xw
from openpyxl.utils import get_column_letter

# ── Source-sheet names (as they appear in Excel external-link syntax) ──────────
SOURCE_SHEETS = {
    "Actual":        "[1]Act",
    "BP":            "[1]BP",
    "FC 2+10":       "'[1]FC2+10'",
    "OL (1+2)":      "[1]OL",
    "LY":            "[1]LY",
    "FC 5+7":        "'[1]FC5+7'",
    "FC 7+5":        "'[1]FC7+5'",
}

# ── Quarter → (source_col_m1, source_col_m2, source_col_m3) in external sheet ─
QUARTER_SOURCE_COLS = {
    1: ("J", "K", "L"),   # M01, M02, M03
    2: ("M", "N", "O"),   # M04, M05, M06
    3: ("P", "Q", "R"),   # M07, M08, M09
    4: ("S", "T", "U"),   # M10, M11, M12
}

QUARTER_MONTH_NAMES = {
    1: ("M01", "M02", "M03"),
    2: ("M04", "M05", "M06"),
    3: ("M07", "M08", "M09"),
    4: ("M10", "M11", "M12"),
}

# ── Category → (col_m1, col_m2, col_m3, col_qsum)  [1-based column numbers] ──
#    These are the *output* columns in the var sheet.
CATEGORY_COLS = {
    "Actual":          ( 6,  7,  8,  9),   # F  G  H  I
    "BP":              (11, 12, 13, 14),   # K  L  M  N
    "Act vs BP":       (15, 16, 17, 18),   # O  P  Q  R
    "FC 2+10":         (20, 21, 22, 23),   # T  U  V  W
    "Act vs FC2+10":   (24, 25, 26, 27),   # X  Y  Z  AA
    "OL (1+2)":        (29, 30, 31, 32),   # AC AD AE AF
    "Act vs OL":       (33, 34, 35, 36),   # AG AH AI AJ
    "LY":              (38, 39, 40, 41),   # AL AM AN AO
    "Act vs LY":       (42, 43, 44, 45),   # AP AQ AR AS
    "FC 5+7":          (50, 51, 52, 53),   # AX AY AZ BA
    "Act vs FC 5+7":   (54, 55, 56, 57),   # BB BC BD BE
    "FC 7+5":          (83, 84, 85, 86),   # CE CF CG CH
    "Act vs FC 7+5":   (87, 88, 89, 90),   # CI CJ CK CL
}

# ── Variance pairs: "Act vs X" -> (actual_col_idx, base_col_idx) in CATEGORY_COLS ─
# Each tuple: (actual_category, base_category)
VARIANCE_PAIRS = {
    "Act vs BP":       ("Actual", "BP"),
    "Act vs FC2+10":   ("Actual", "FC 2+10"),
    "Act vs OL":       ("Actual", "OL (1+2)"),
    "Act vs LY":       ("Actual", "LY"),
    "Act vs FC 5+7":   ("Actual", "FC 5+7"),
    "Act vs FC 7+5":   ("Actual", "FC 7+5"),
}


def _source_col(quarter: int, month_pos: int) -> str:
    """Return the source sheet column letter for a given quarter + month position (1-3)."""
    return QUARTER_SOURCE_COLS[quarter][month_pos - 1]


def _make_pull_formula(sheet_ref: str, src_col: str, row: int) -> str:
    """
    Build: =IF({sheet}!{col}$3=1,{sheet}!{col}{src_row},"")
    The source row in the external sheet is var_row - 1 (observed convention).
    The $3 flag row controls whether the month is 'active' (populated) in the source.
    """
    src_row = row - 1
    return f'=IF({sheet_ref}!{src_col}$3=1,{sheet_ref}!{src_col}{src_row},"")'


def _make_variance_formula(act_col: str, base_col: str, row: int, is_qsum: bool) -> str:
    """
    Build: =IFERROR({act_col}{row}-{base_col}{row},0)  for month columns
           ={act_q}{row}-{base_q}{row}                 for Q-sum columns
    """
    if is_qsum:
        return f"={act_col}{row}-{base_col}{row}"
    return f"=IFERROR({act_col}{row}-{base_col}{row},0)"


def _make_qsum_formula(m1_col: str, m3_col: str, row: int) -> str:
    """Build: =SUM({m1_col}{row}:{m3_col}{row})"""
    return f"=SUM({m1_col}{row}:{m3_col}{row})"


def _build_formulas(category: str, quarter: int, row: int):
    """
    Returns a dict: {col_number: formula_string}
    covering all three month columns + the Q-sum column for the given category/quarter/row.
    """
    if category not in CATEGORY_COLS:
        raise ValueError(f"Unknown category '{category}'. Valid: {list(CATEGORY_COLS)}")
    if quarter not in range(1, 5):
        raise ValueError(f"quarter must be 1-4, got {quarter}")

    cols = CATEGORY_COLS[category]          # (c1, c2, c3, cq)
    src_cols = QUARTER_SOURCE_COLS[quarter]  # ('S','T','U') for Q4 etc.
    out = {}

    if category in VARIANCE_PAIRS:
        # ── Variance columns: subtract base from actual ──────────────────────
        act_cat, base_cat = VARIANCE_PAIRS[category]
        act_cols  = CATEGORY_COLS[act_cat]
        base_cols = CATEGORY_COLS[base_cat]

        for i in range(3):
            act_letter  = get_column_letter(act_cols[i])
            base_letter = get_column_letter(base_cols[i])
            out[cols[i]] = _make_variance_formula(act_letter, base_letter, row, is_qsum=False)

        # Q-sum variance = act_qsum - base_qsum
        act_q  = get_column_letter(act_cols[3])
        base_q = get_column_letter(base_cols[3])
        out[cols[3]] = _make_variance_formula(act_q, base_q, row, is_qsum=True)

    else:
        # ── Pull-from-source columns ─────────────────────────────────────────
        sheet_ref = SOURCE_SHEETS[category]
        for i in range(3):
            out[cols[i]] = _make_pull_formula(sheet_ref, src_cols[i], row)

        # Q-sum = SUM of the three month cols
        m1_letter = get_column_letter(cols[0])
        m3_letter = get_column_letter(cols[2])
        out[cols[3]] = _make_qsum_formula(m1_letter, m3_letter, row)

    return out


def regenerate_formula(
    ws,
    category: str,
    quarter: int,
    month,         # int 1-3, or None for all months + Qsum
    row: int,
    dry_run: bool = False,
) -> dict:
    """
    Write formula(s) into the xlwings worksheet `ws`.

    Parameters
    ----------
    ws       : xlwings Sheet object
    category : str   — see CATEGORY_COLS keys
    quarter  : int   — 1 to 4
    month    : int or None — 1=first month in quarter, 2=second, 3=third
                             None = write all three months + Q-sum
    row      : int   — Excel row number
    dry_run  : bool  — if True, return the formula dict without writing to sheet

    Returns
    -------
    dict of {col_number: formula_string} that was (or would be) written.
    """
    all_formulas = _build_formulas(category, quarter, row)

    if month is not None:
        if month not in (1, 2, 3):
            raise ValueError(f"month must be 1, 2, 3 or None; got {month}")
        # Only the requested month column (not the Q-sum)
        col_number = CATEGORY_COLS[category][month - 1]
        selected = {col_number: all_formulas[col_number]}
    else:
        selected = all_formulas   # all three months + Q-sum

    if not dry_run:
        for col_num, formula in selected.items():
            col_letter = get_column_letter(col_num)
            ws.range(f"{col_letter}{row}").formula = formula

    month_names = QUARTER_MONTH_NAMES[quarter]
    if month is None:
        written_months = f"{month_names[0]}/{month_names[1]}/{month_names[2]}+Qsum"
    else:
        written_months = month_names[month - 1]

    print(f"{'[DRY RUN] ' if dry_run else ''}Category='{category}' | Q{quarter} | "
          f"{written_months} | row={row}")
    for col_num, formula in selected.items():
        print(f"  {get_column_letter(col_num)}{row} => {formula}")

    return selected


# ── Quick self-test (no xlwings needed) ──────────────────────────────────────
def _self_test():
    print("=== SELF-TEST (dry_run, no file needed) ===\n")

    class FakeWS:
        """Minimal stub so regenerate_formula works without xlwings."""
        class _Rng:
            def __init__(self, addr): self.addr = addr
            @property
            def formula(self): return None
            @formula.setter
            def formula(self, v): print(f"    WRITE {self.addr} = {v}")
        def range(self, addr): return self._Rng(addr)

    ws = FakeWS()

    # Test 1: Actual, Q4, all months, row 7 — should match existing file formulas
    print("--- Test 1: Actual Q4 all months row 7 ---")
    regenerate_formula(ws, "Actual", quarter=4, month=None, row=7, dry_run=True)

    # Test 2: BP, Q4, month 1 only, row 7
    print("\n--- Test 2: BP Q4 month=1 row 7 ---")
    regenerate_formula(ws, "BP", quarter=4, month=1, row=7, dry_run=True)

    # Test 3: Act vs OL, Q4, all months, row 7
    print("\n--- Test 3: Act vs OL Q4 all months row 7 ---")
    regenerate_formula(ws, "Act vs OL", quarter=4, month=None, row=7, dry_run=True)

    # Test 4: OL (1+2), Q3 (M07/M08/M09), all months, row 10
    print("\n--- Test 4: OL (1+2) Q3 all months row 10 ---")
    regenerate_formula(ws, "OL (1+2)", quarter=3, month=None, row=10, dry_run=True)

    # Test 5: FC 7+5, Q1 (M01/M02/M03), month 2, row 15
    print("\n--- Test 5: FC 7+5 Q1 month=2 row 15 ---")
    regenerate_formula(ws, "FC 7+5", quarter=1, month=2, row=15, dry_run=True)

    # Test 6: Act vs LY, Q2 (M04/M05/M06), all months, row 20
    print("\n--- Test 6: Act vs LY Q2 all months row 20 ---")
    regenerate_formula(ws, "Act vs LY", quarter=2, month=None, row=20, dry_run=True)

    print("\n=== All tests passed ===")


if __name__ == "__main__":
    _self_test()








