def update_elapsed_time():
    start = time.time()
    while not _stop_event.is_set():
        secs = int(time.time() - start)
        m, s = divmod(secs, 60)
        root.after(0, elapsed_time_label.config, {"text": f"Elapsed: {m:02d}:{s:02d}"})
        time.sleep(0.5)

