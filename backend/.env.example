# Copy this file to .env (or set these in your shell) and restart the backend.
# Windows PowerShell example:
#   $env:AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
#   $env:AZURE_OPENAI_KEY="your-key-here"
#   $env:AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
#   python -m uvicorn app.main:app --reload --port 8000
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# --- price comparison data source -------------------------------------
# Default is the built-in SQL pipeline (CSV -> SQLite). When a live feed
# exists, switch to it here — no code changes needed:
# PRICE_SOURCE_MODE=api
# PRICE_API_URL=https://your-feed.example.com/prices
# PRICE_API_KEY=optional-key-sent-as-X-API-Key

# --- multi-agent assistant LLM (either option works; OpenAI checked first) ---
# Option A: plain OpenAI (gpt-4o-mini by default)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Option B: Azure OpenAI (uses the AZURE_OPENAI_* vars above)
# Web research agent uses free DuckDuckGo search (ddgs) — no key needed.
