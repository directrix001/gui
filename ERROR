def _safe_find_fmi_nv(df, name):
    if not _df_ok(df, name): return (0,)*16
    try:    return tuple(_int(x, f"fmi_nv({name})") for x in find_fmi_row_nv(df, fallback_rows=(73, 81, 89, 97)) )
    except Exception as e:
        logger.warning(f"find_fmi_row_nv({name}): {e}")
        z_audit.record("EXCEPTION", str(e), f"find_fmi_row_nv({name})")
        return (0,)*16
