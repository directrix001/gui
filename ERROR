def find_fmi_row_nv(df: pd.DataFrame):
    starts = _brand_starts(df, "nissan nv", "datsun nv", "infiniti nv", "total nv")
    
    # AFTER: replace raise with warning + zero tuple
    if any(s is None for s in starts):
        missing = [
            label for label, s in zip(
                ["nissan nv", "datsun nv", "infiniti nv", "total nv"], starts
            ) if s is None
        ]
        logger.warning(
            f"find_fmi_row_nv: labels not found → {missing}. Returning zeros."
        )
        return (0,) * 16  # 4 brands × 4 values each

    rows = [_find_fmi_indices(df, s) for s in starts]
    if any(r is None for r in rows):
        logger.warning("find_fmi_row_nv: FMI indices incomplete. Returning zeros.")
        return (0,) * 16

    return tuple(v for r in rows for v in r)
