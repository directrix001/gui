     fmi_tot_nv, trn_tot_nv, cos_tot_nv, vme_tot_nv,
     ) = _safe_find_fmi_nv(df_P_L_ROP_NE, "df_P_L_ROP_NE") if HAS_ROP_NE else (0,)*16
