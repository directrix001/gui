    logger.info(f"P&L output written → {result_path}  ({time.time()-t0:.1f}s)")

    # ── Write Z-audit report ──────────────────────────────────────────────────
    audit_report_path = z_audit.write_report(output_path)
    logger.info(f"Z-Audit report → {audit_report_path}")

